{"annotations":{"list":[]},"description":"Stream F dashboard. NOTE for coordinator: copy this file into the umbrella repo monitoring/grafana/dashboards/ and provision it like the existing overview/data-quality dashboards. Panels read llm_* series emitted by common/llm/metrics.py via the existing /metrics endpoint.","panels":[{"fieldConfig":{"defaults":{"unit":"currencyUSD"}},"gridPos":{"h":8,"w":12,"x":0,"y":0},"id":1,"targets":[{"expr":"sum by (purpose) (increase(llm_cost_usd_total[1d]))","legendFormat":"{{purpose}}"}],"title":"Cost per day by purpose (USD)","type":"timeseries"},{"fieldConfig":{"defaults":{"unit":"currencyUSD"}},"gridPos":{"h":8,"w":12,"x":12,"y":0},"id":2,"targets":[{"expr":"sum by (provider, model) (increase(llm_cost_usd_total[1d]))","legendFormat":"{{provider}}/{{model}}"}],"title":"Cost per day by provider/model (USD)","type":"timeseries"},{"fieldConfig":{"defaults":{"unit":"s"}},"gridPos":{"h":8,"w":12,"x":0,"y":8},"id":3,"targets":[{"expr":"histogram_quantile(0.50, sum by (le, purpose) (rate(llm_latency_seconds_bucket[5m])))","legendFormat":"p50 {{purpose}}"},{"expr":"histogram_quantile(0.95, sum by (le, purpose) (rate(llm_latency_seconds_bucket[5m])))","legendFormat":"p95 {{purpose}}"}],"title":"LLM latency p50 / p95 by purpose","type":"timeseries"},{"gridPos":{"h":8,"w":12,"x":12,"y":8},"id":4,"targets":[{"expr":"sum by (purpose, status) (rate(llm_requests_total[5m]))","legendFormat":"{{purpose}} {{status}}"}],"title":"Requests by purpose / status","type":"timeseries"},{"gridPos":{"h":8,"w":12,"x":0,"y":16},"id":5,"targets":[{"expr":"sum by (kind) (increase(llm_tokens_total[1d]))","legendFormat":"{{kind}}"}],"title":"Tokens per day by kind","type":"timeseries"},{"gridPos":{"h":8,"w":6,"x":12,"y":16},"id":6,"targets":[{"expr":"sum by (kind) (increase(llm_budget_exhaustions_total[24h]))","legendFormat":"{{kind}}"}],"title":"Budget exhaustions","type":"stat"},{"description":"Populated once callers enable LLM_CACHE_TTL_SECONDS per purpose and use common/llm/cache.py. Semantic-cache panels arrive with the retrieval stream (pgvector) — semantic caching applies to retrieval results only, never generated financial answers.","fieldConfig":{"defaults":{"max":1,"min":0,"unit":"percentunit"}},"gridPos":{"h":8,"w":6,"x":18,"y":16},"id":7,"targets":[{"expr":"sum(rate(llm_cache_total{result=\"hit\"}[5m])) / sum(rate(llm_cache_total[5m]))","legendFormat":"hit rate"}],"title":"Exact-match cache hit rate (placeholder for caching step)","type":"timeseries"},{"gridPos":{"h":8,"w":12,"x":0,"y":24},"id":8,"targets":[{"expr":"sum by (provider) (increase(llm_circuit_breaker_total{event=\"opened\"}[1h]))","legendFormat":"{{provider}}"}],"title":"Circuit breaker openings","type":"timeseries"}],"refresh":"1m","schemaVersion":39,"templating":{"list":[]},"time":{"from":"now-7d","to":"now"},"title":"CreditMate — AI Cost & Latency","uid":"creditmate-ai-cost-latency","version":1}