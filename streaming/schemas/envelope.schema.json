{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer"
    },
    "occurred_at": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}