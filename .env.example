# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Environment Configuration (local/staging/production)
# Email service is only enabled in production environment
ENVIRONMENT=local

# Database Configuration (PostgreSQL 17)
# PostgreSQL engine is hardcoded in settings.py
DB_NAME=creditmate_db
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Bank Crawler Configuration (LLM providers)
# OpenRouter (OPENROUTER_API_KEY) and Gemini (GEMINI_API_KEY) are the LLM providers.
OPENROUTER_API_KEY=your-openrouter-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# Cache (redis by default; use CACHE_BACKEND=locmem without a Redis server)
REDIS_CACHE_URL=redis://localhost:6379/1

# Frontend base URL used in verification, password-reset and alert unsubscribe links
FRONTEND_URL=http://localhost:3000

# Search (Elasticsearch). Disabled by default; set to True to enable indexing/search.
SEARCH_ENABLED=False

# Logging level for the console handler (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Celery Configuration (Redis broker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Sentry Error Monitoring (optional)
# Leave SENTRY_DSN unset to keep Sentry disabled.
SENTRY_DSN=
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT defaults to ENVIRONMENT.
# SENTRY_RELEASE=1.5.0
# Percentage of traces sampled (0.0 to 1.0); defaults to 0.1.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS Configuration
# Comma-separated list of allowed origins for frontend applications
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=True
# For development only - NEVER use in production
# CORS_ALLOW_ALL_ORIGINS=False

# Comma-separated origins (with scheme) trusted for CSRF, e.g. the admin on your API domain
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# API Rate Limiting
THROTTLE_RATE_ANON=100/min
THROTTLE_RATE_USER=1000/min
THROTTLE_RATE_BURST=10/sec

# API Request Validation
MAX_JSON_REQUEST_BYTES=1048576
MAX_UPLOAD_REQUEST_BYTES=10485760

# Email Configuration (Only for production environment)
# Sender address for verification, password-reset and alert emails
DEFAULT_FROM_EMAIL=noreply@creditmate.ai
# Optional comma-separated recipients for high-priority review queue alerts.
REVIEW_QUEUE_NOTIFY_EMAILS=
# For local/staging: emails are disabled automatically
# For production: configure SMTP settings below
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Production Email Configuration Examples
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True
# SendGrid: EMAIL_HOST=smtp.sendgrid.net, EMAIL_PORT=587, EMAIL_USE_TLS=True
# Mailgun: EMAIL_HOST=smtp.mailgun.org, EMAIL_PORT=587, EMAIL_USE_TLS=True

# Additional Production Settings
# ENVIRONMENT=production
# DEBUG=False
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
